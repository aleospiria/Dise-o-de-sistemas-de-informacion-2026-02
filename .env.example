# Copia este archivo a .env y completa los valores marcados como OBLIGATORIO.
# El .env real NUNCA se sube al repositorio (está en .gitignore).
# Evita los caracteres $ y % en los valores (Compose y Alembic los interpretan).

# ---------------------------------------------------------------- Publicación
# Puerto del host donde se publica la app (nginx escucha en 8080 dentro del contenedor).
APP_PORT=8080
# 127.0.0.1 = solo accesible desde el propio servidor (recomendado con Cloudflare
# Tunnel o un proxy inverso). 0.0.0.0 = accesible desde la red.
APP_BIND=127.0.0.1

# ---------------------------------------------------------------- Frontend
# URL base de la API compilada en el bundle. /api/v1 usa el mismo origen (nginx
# reenvía /api/ al contenedor api). Si lo cambias, hay que reconstruir: up -d --build.
VITE_API_BASE_URL=/api/v1

# ---------------------------------------------------------------- Base de datos
POSTGRES_DB=prestamos_lab
POSTGRES_USER=prestamos_app
# OBLIGATORIO. Genérala con: openssl rand -hex 24
# (si cambias la contraseña después de crear el volumen, ver docs/despliegue.md)
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- API
# OBLIGATORIO. Secreto con el que se firman los tokens. Genéralo con: openssl rand -hex 32
# Si lo cambias, todas las sesiones abiertas dejan de ser válidas.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=production

# URL pública desde la que se abre la app (sin barra final). Con Quick Tunnel es
# la URL https://xxxx.trycloudflare.com; con dominio propio, https://tu-dominio.example.
# CORS_ORIGINS admite varios orígenes separados por comas.
CORS_ORIGINS=https://tu-dominio.example
FRONTEND_URL=https://tu-dominio.example

# true = carga las cuentas y los recursos de demostración si la base está vacía
# (solo actúa en el primer arranque). Pásalo a false cuando termine la demostración.
SEED_ON_STARTUP=true
# false en producción. Con true, la API devuelve el token de recuperación de
# contraseña en la respuesta HTTP (no se envía ningún correo).
EXPOSE_RESET_TOKEN=false
PASSWORD_RESET_EXPIRE_MINUTES=60

# Verificación en dos pasos (2FA)
TWO_FACTOR_CHALLENGE_MINUTES=5
TWO_FACTOR_MAX_ATTEMPTS=3
TWO_FACTOR_LOCK_MINUTES=15

# Reglas del laboratorio
LAB_TIMEZONE=America/Bogota
LAB_OPEN_HOUR=7
LAB_CLOSE_HOUR=20
MAX_ACTIVE_LOANS=3

# ---------------------------------------------------------------- Cloudflare
# Token del túnel con nombre (solo con: docker compose --profile tunnel up -d).
# Se obtiene en Zero Trust > Networks > Tunnels. Déjalo vacío si no lo usas.
# NUNCA subas un token real al repositorio.
CLOUDFLARE_TUNNEL_TOKEN=
