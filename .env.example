# Copia este archivo a .env para cambiar los valores (el .env real no se commitea).
# Puerto del host donde se publica la aplicación.
APP_PORT=8080

# Dirección donde se publica el puerto en el host.
# 0.0.0.0 = accesible desde la red; 127.0.0.1 = solo desde la propia máquina
# (usar 127.0.0.1 con el túnel de Cloudflare o un proxy inverso).
APP_BIND=0.0.0.0

# Token del túnel de Cloudflare (solo con --profile tunnel).
# Se obtiene en Zero Trust > Networks > Tunnels. Déjalo vacío si no usas el túnel.
# NUNCA subas un token real al repositorio.
CLOUDFLARE_TUNNEL_TOKEN=
