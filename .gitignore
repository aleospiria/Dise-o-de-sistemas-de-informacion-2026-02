# Sistema de Préstamos - Root .gitignore

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea

# Temporary files
*.tmp
*.temp

# Logs at root level
*.log

# Kiro cache (mantener specs y steering)
.kiro/cache/
.kiro/temp/

# Python backend
backend/.venv/
**/__pycache__/
*.py[cod]
*.egg-info/
backend/.env
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/htmlcov/
backend/.coverage
backend/*.db
backend/*.sqlite3
