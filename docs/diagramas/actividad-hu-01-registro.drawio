<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Kiro" version="21.0.0" type="device">
  <diagram name="Actividad-HU-01" id="actividad-hu-01">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Diagrama de actividades HU-01 - Registro de nuevo usuario" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="40" as="geometry"/></mxCell>
        <mxCell id="descripcion" value="Flujo implementado del registro en /register. La cédula solo se exige (no se valida su formato ni su unicidad) y el carnet solo es obligatorio para el rol Estudiante. La única unicidad que se comprueba es la del correo." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1020" height="50" as="geometry"/></mxCell>
        <mxCell id="carril-usuario" value="Visitante" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=center;fillColor=#eef4fb;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="320" height="1470" as="geometry"/></mxCell>
        <mxCell id="carril-sistema" value="Sistema" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=center;fillColor=#f7f7f7;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="640" height="1470" as="geometry"/></mxCell>
        <mxCell id="inicio" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="195" y="170" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="a1" value="Abrir la pantalla Crear cuenta (/register)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="a2" value="Completar nombre, correo, cédula, rol, carnet (solo si es Estudiante), contraseña y confirmación de contraseña" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="330" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="a3" value="Enviar el formulario con el botón Crear cuenta" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="470" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="s1" value="Validar los campos del formulario (obligatorios, correo, contraseña fuerte y confirmación)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="460" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="d1" value="¿Los campos son válidos?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="580" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="b1" value="Mostrar el error bajo cada campo inválido y bloquear el botón hasta corregirlo" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="595" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="s2" value="Buscar el correo, sin distinguir mayúsculas, entre los usuarios guardados" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="740" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="d2" value="¿El correo ya está registrado?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="860" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="b2" value="Mostrar la alerta «El correo ya está registrado.»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="875" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="s3" value="Crear el usuario (identificador único, contraseña con hash, fecha de registro) y guardarlo en localStorage" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1020" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="d3" value="¿Se guardó en el almacenamiento?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="1160" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="b3" value="Mostrar la alerta «No se pudo guardar en el almacenamiento del navegador…»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="1175" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="fin2" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="1295" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="s4" value="Mostrar el aviso «Cuenta creada. Ya puedes iniciar sesión.»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1320" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="Redirigir a /login con el correo precargado" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1420" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="a4" value="Ver la pantalla de inicio de sesión con el correo ya escrito" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="1420" width="220" height="60" as="geometry"/></mxCell>
