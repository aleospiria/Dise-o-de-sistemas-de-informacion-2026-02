<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Kiro" version="21.0.0" type="device">
  <diagram name="C4-2-Contenedores" id="c4-2-contenedores">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="&lt;b&gt;[Nivel 2] Contenedores: Sistema de préstamo de recursos de laboratorio&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="40" as="geometry"/></mxCell>
        <mxCell id="descripcion" value="Muestra las piezas ejecutables del sistema: una SPA en el navegador que guarda todo en localStorage. El backend y el servidor nginx aparecen en gris porque no forman parte del MVP en main." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1620" height="50" as="geometry"/></mxCell>
        <mxCell id="p-est" value="&lt;b&gt;Estudiante&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Consulta disponibilidad, solicita préstamos y ve Mis préstamos." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="140" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="p-tec" value="&lt;b&gt;Técnico de laboratorio&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Registra entregas y devoluciones de recursos." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="140" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="p-adm" value="&lt;b&gt;Administrador de laboratorio&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Gestiona el inventario y las operaciones." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="710" y="140" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="limite" value="&lt;b&gt;Sistema de préstamo de recursos de laboratorio&lt;/b&gt;&lt;br&gt;[Software System]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 8;verticalAlign=bottom;align=right;spacingRight=10;spacingBottom=6;fontColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="980" height="900" as="geometry"/></mxCell>
        <mxCell id="spa" value="&lt;b&gt;Aplicación web SPA&lt;/b&gt;&lt;br&gt;[Container: React 19 + TypeScript + Vite 8]&lt;br&gt;Aplicación de una sola página que se ejecuta en el navegador. Rutas protegidas por rol (React Router v7), formularios con React Hook Form, estilos con CSS Modules y estado con Context + useReducer. Implementa registro e inicio de sesión, consulta de disponibilidad, solicitud de préstamos, entregas y devoluciones, e inventario." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="900" height="200" as="geometry"/></mxCell>
        <mxCell id="e-p-est" value="Consulta, solicita y ve sus préstamos&lt;br&gt;[Navegador web, HTTP(S)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.16667;entryY=0;" edge="1" parent="1" source="p-est" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-p-tec" value="Registra entregas y devoluciones&lt;br&gt;[Navegador web, HTTP(S)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p-tec" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-p-adm" value="Gestiona inventario y operaciones&lt;br&gt;[Navegador web, HTTP(S)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.83333;entryY=0;" edge="1" parent="1" source="p-adm" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="storage" value="&lt;b&gt;Almacenamiento local del navegador&lt;/b&gt;&lt;br&gt;[Container: localStorage, namespace sistema-prestamos-lab-]&lt;br&gt;Persistencia simulada de todos los datos del MVP; no hay base de datos ni servidor." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="800" width="420" height="210" as="geometry"/></mxCell>
        <mxCell id="e-spa-storage" value="Lee y escribe JSON&lt;br&gt;[Web Storage API, vía puerto StorageRepository]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.23333;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="spa" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="claves" value="&lt;b&gt;Claves de localStorage&lt;/b&gt; (prefijo sistema-prestamos-lab-)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="780" width="420" height="400" as="geometry"/></mxCell>
        <mxCell id="k-users" value="&lt;b&gt;users&lt;/b&gt;: cuentas registradas y su rol" style="rounded=1;arcSize=8;spacing=4;align=left;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="580" y="820" width="380" height="40" as="geometry"/></mxCell>
        <mxCell id="k-resources" value="&lt;b&gt;resources&lt;/b&gt;: inventario de recursos y su estado" style="rounded=1;arcSize=8;spacing=4;align=left;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="580" y="870" width="380" height="40" as="geometry"/></mxCell>
        <mxCell id="k-loans" value="&lt;b&gt;loans&lt;/b&gt;: préstamos y reservas" style="rounded=1;arcSize=8;spacing=4;align=left;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="580" y="920" width="380" height="40" as="geometry"/></mxCell>
        <mxCell id="k-history" value="&lt;b&gt;status-history&lt;/b&gt;: historial de estados de recursos. Solo se escribe; ninguna pantalla lo lee" style="rounded=1;arcSize=8;spacing=4;align=left;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="580" y="970" width="380" height="40" as="geometry"/></mxCell>
        <mxCell id="k-session" value="&lt;b&gt;session&lt;/b&gt;: sesión activa con fecha de expiración" style="rounded=1;arcSize=8;spacing=4;align=left;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="580" y="1020" width="380" height="40" as="geometry"/></mxCell>
        <mxCell id="k-init" value="&lt;b&gt;initialized&lt;/b&gt;: bandera de siembra de datos iniciales" style="rounded=1;arcSize=8;spacing=4;align=left;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="580" y="1070" width="380" height="40" as="geometry"/></mxCell>
        <mxCell id="k-sanctions" value="&lt;b&gt;sanctions&lt;/b&gt;: solo se siembra; ningún código la usa (Sanciones: Post-MVP)" style="rounded=1;arcSize=8;spacing=4;align=left;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="580" y="1120" width="380" height="40" as="geometry"/></mxCell>
        <mxCell id="deploy" value="&lt;b&gt;Servidor web nginx en Docker&lt;/b&gt;&lt;br&gt;[Container: nginx-unprivileged 1.28 (Docker)]&lt;br&gt;Solo existe en la rama feature/deploy-docker; no incluido en main. Serviría los archivos estáticos de la SPA en el puerto 8080." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="1260" y="480" width="340" height="200" as="geometry"/></mxCell>
        <mxCell id="e-deploy-spa" value="FUTURO (rama de despliegue)&lt;br&gt;Entrega los archivos estáticos&lt;br&gt;[HTTP :8080]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#999999;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 8;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="deploy" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="backend" value="&lt;b&gt;Backend / API&lt;/b&gt;&lt;br&gt;[Container futuro: no implementado, fuera del MVP]&lt;br&gt;FUTURO. Sustituiría a localStorage detrás del puerto StorageRepository con otro adaptador. No existe en main." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="1260" y="800" width="340" height="200" as="geometry"/></mxCell>
        <mxCell id="e-spa-backend" value="FUTURO: API HTTPS/JSON&lt;br&gt;(otro adaptador del puerto)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#999999;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 8;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="spa" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="100" width="380" height="290" as="geometry"/></mxCell>
