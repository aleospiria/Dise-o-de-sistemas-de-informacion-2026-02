        <mxCell id="lg4-t" value="Módulo con funciones exportadas, tabla de constantes o utilidades" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1540" y="1800" width="620" height="20" as="geometry"/></mxCell>
