  <diagram name="Nivel 4b - Persistencia y comportamiento" id="c4-4b-persistencia">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2640" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="&lt;b&gt;[Nivel 4] Código / Clases: persistencia y comportamiento (storage, servicios de mockDb, máquina de estados y estrategia de devolución)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2300" height="40" as="geometry"/></mxCell>
        <mxCell id="descripcion" value="Muestra el puerto StorageRepository con sus dos implementaciones, los módulos de services/mockDb (funciones exportadas, sin clases ni factorías), las tablas declarativas de shared/constants/resourceStateMachine.ts y las funciones puras de shared/utils. Los rótulos amarillos marcan patrones candidatos; los cinco definitivos se eligen en la sección 3." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2300" height="30" as="geometry"/></mxCell>
        <mxCell id="nota-e1" value="&lt;b&gt;Relación con el diagrama de clases del Entregable 1.&lt;/b&gt; Los métodos de las clases del E1 son hoy funciones de servicio: Usuario.iniciarSesion() → loginUser; cerrarSesion() → logoutUser; actualizarPerfil() → updateUser; Recurso.actualizarEstado() → updateResourceStatus; darDeBaja() → retireResource; Prestamo.registrarEntrega() → registerDelivery; registrarDevolucion() → registerReturn; calcularRetraso() → calculateDelayHours (dateUtils). Rol.asignarPermisos() no tiene equivalente. Clases de datos: ver página 4a." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="870" height="80" as="geometry"/></mxCell>
        <mxCell id="marco-storage" value="&lt;b&gt;services/storage&lt;/b&gt; (puerto y adaptadores)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="870" height="760" as="geometry"/></mxCell>
        <mxCell id="StorageRepository" value="«interface»&lt;br&gt;&lt;b&gt;StorageRepository&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="490" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="StorageRepository-m" value="get&amp;lt;T&amp;gt;(key: string): T | null&lt;br&gt;set&amp;lt;T&amp;gt;(key: string, value: T): void&lt;br&gt;remove(key: string): void" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;whiteSpace=nowrap;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="StorageRepository"><mxGeometry x="0" y="40" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="nota-repo" value="&lt;b&gt;Repository / Adapter&lt;/b&gt;&lt;br&gt;patrón candidato (por confirmar en la sección 3 del entregable)&lt;br&gt;StorageRepository es el puerto; LocalStorageRepository adapta localStorage e InMemoryStorageRepository adapta un Map al mismo contrato." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="LocalStorageRepository" value="&lt;b&gt;LocalStorageRepository&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="LocalStorageRepository-m" value="get&amp;lt;T&amp;gt;(key: string): T | null&lt;br&gt;set&amp;lt;T&amp;gt;(key: string, value: T): void&lt;br&gt;remove(key: string): void" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;whiteSpace=nowrap;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="LocalStorageRepository"><mxGeometry x="0" y="30" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="InMemoryStorageRepository" value="&lt;b&gt;InMemoryStorageRepository&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="720" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="InMemoryStorageRepository-a" value="- store: Map&amp;lt;string, string&amp;gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;whiteSpace=nowrap;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="InMemoryStorageRepository"><mxGeometry x="0" y="30" width="340" height="26" as="geometry"/></mxCell>
        <mxCell id="InMemoryStorageRepository-s" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#6c8ebf;" vertex="1" parent="InMemoryStorageRepository"><mxGeometry x="0" y="56" width="340" height="8" as="geometry"/></mxCell>
        <mxCell id="InMemoryStorageRepository-m" value="get&amp;lt;T&amp;gt;(key: string): T | null&lt;br&gt;set&amp;lt;T&amp;gt;(key: string, value: T): void&lt;br&gt;remove(key: string): void&lt;br&gt;clear(): void" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;whiteSpace=nowrap;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="InMemoryStorageRepository"><mxGeometry x="0" y="64" width="340" height="86" as="geometry"/></mxCell>
        <mxCell id="nota-instancia" value="Instancia por defecto exportada: localStorageRepository = new LocalStorageRepository()." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="ls-nav" value="&lt;b&gt;localStorage&lt;/b&gt;&lt;br&gt;[Web Storage API del navegador]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="LS_KEYS" value="«constant» as const&lt;br&gt;&lt;b&gt;LS_KEYS (shared/constants/lsKeys.ts)&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="950" width="400" height="180" as="geometry"/></mxCell>
        <mxCell id="LS_KEYS-a" value="USERS = 'sistema-prestamos-lab-users'&lt;br&gt;RESOURCES = 'sistema-prestamos-lab-resources'&lt;br&gt;LOANS = 'sistema-prestamos-lab-loans'&lt;br&gt;STATUS_HISTORY = 'sistema-prestamos-lab-status-history'&lt;br&gt;SANCTIONS = 'sistema-prestamos-lab-sanctions'&lt;br&gt;SESSION = 'sistema-prestamos-lab-session'&lt;br&gt;INITIALIZED = 'sistema-prestamos-lab-initialized'" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;whiteSpace=nowrap;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="LS_KEYS"><mxGeometry x="0" y="40" width="400" height="140" as="geometry"/></mxCell>
        <mxCell id="cliente" value="&lt;b&gt;contexts: AuthProvider y AppDataProvider&lt;/b&gt; (clientes de los servicios)&lt;br&gt;Reciben repository?: StorageRepository (valor por defecto localStorageRepository, definido en app/providers.tsx) y lo pasan como último argumento de cada función. Las pruebas inyectan InMemoryStorageRepository." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=8 8;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1000" y="260" width="680" height="100" as="geometry"/></mxCell>
        <mxCell id="loans.service" value="«module»&lt;br&gt;&lt;b&gt;services/mockDb/loans.service.ts&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1020" y="520" width="640" height="250" as="geometry"/></mxCell>
        <mxCell id="loans.service-m" value="checkAvailability(resourceId: string, start: string, end: string, repo?): boolean&lt;br&gt;getAvailableResources(start: string, end: string,&lt;br&gt;    filters?: ResourceFilters, repo?): Resource[]&lt;br&gt;createLoan(data: LoanFormData, userId: string, repo?): OperationResult&amp;lt;Loan&amp;gt;&lt;br&gt;getLoansByUser(userId: string, repo?): Loan[]&lt;br&gt;getPendingDeliveries(repo?): Loan[]&lt;br&gt;getPendingReturns(repo?): Loan[]&lt;br&gt;registerDelivery(loanId: string, data: DeliveryData, repo?): OperationResult&amp;lt;Loan&amp;gt;&lt;br&gt;registerReturn(loanId: string, data: ReturnData, repo?): OperationResult&amp;lt;Loan&amp;gt;&lt;br&gt;- readLoans(repo), writeLoans(repo, loans), isActive(loan)&lt;br&gt;- countOverlapping(loans, resourceId, start, end), updateLoan(repo, loanId, patch)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;whiteSpace=nowrap;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="loans.service"><mxGeometry x="0" y="40" width="640" height="210" as="geometry"/></mxCell>
        <mxCell id="resources.service" value="«module»&lt;br&gt;&lt;b&gt;services/mockDb/resources.service.ts&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1020" y="860" width="640" height="250" as="geometry"/></mxCell>
        <mxCell id="resources.service-m" value="getResources(filters?: ResourceFilters, repo?): Resource[]&lt;br&gt;getResourceById(id: string, repo?): Resource | undefined&lt;br&gt;createResource(data: CreateResourceData, repo?): OperationResult&amp;lt;Resource&amp;gt;&lt;br&gt;updateResource(id: string, data: Partial&amp;lt;CreateResourceData&amp;gt;,&lt;br&gt;    repo?): OperationResult&amp;lt;Resource&amp;gt;&lt;br&gt;updateResourceStatus(id: string, newStatus: ResourceStatus,&lt;br&gt;    motivo: string | undefined, repo?): OperationResult&amp;lt;void&amp;gt;&lt;br&gt;adjustAvailableQuantity(id: string, delta: number, repo?): OperationResult&amp;lt;Resource&amp;gt;&lt;br&gt;retireResource(id: string, repo?): OperationResult&amp;lt;void&amp;gt;&lt;br&gt;- readResources(repo), writeResources(repo, resources)&lt;br&gt;- appendStatusHistory(repo, entry), reconcileStockState(resource, repo)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;overflow=hidden;rotatable=0;whiteSpace=nowrap;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="resources.service"><mxGeometry x="0" y="40" width="640" height="210" as="geometry"/></mxCell>
