        <mxCell id="lg2-t" value="Puerto: interface que otras clases implementan" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1540" y="1720" width="620" height="20" as="geometry"/></mxCell>
