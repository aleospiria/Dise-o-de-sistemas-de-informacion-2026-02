        <mxCell id="marco-dto" value="&lt;b&gt;Tipos de entrada, filtros y resultado de operación&lt;/b&gt; (shared/types): los servicios los reciben o devuelven, no se guardan como entidades" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="1090" width="2150" height="260" as="geometry"/></mxCell>
        <mxCell id="tabla-e1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1420" width="1250" height="480" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-t" value="&lt;b&gt;Trazabilidad Entregable 1 → código&lt;/b&gt; (diagrama de clases del E1 frente a src/shared/types)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#d79b00;fontColor=#ffffff;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="1420" width="1250" height="40" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c1" value="Entregable 1 (diagrama de clases)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffe6cc;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="1460" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c2" value="Código (src/shared/types)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffe6cc;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="1460" width="330" height="30" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c3" value="Qué cambió" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffe6cc;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="1460" width="620" height="30" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c4" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;idUsuario (int), nombre, correo, cedula, contrasena, carnet, fechaRegistro&lt;br&gt;iniciarSesion(), cerrarSesion(), actualizarPerfil()" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="1490" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c5" value="&lt;b&gt;User&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="1490" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c6" value="idUsuario pasa de int a string. Aparecen idRol (la relación con Rol) y sanctionEndDate? (Post-MVP). Los métodos viven en funciones de servicio: loginUser, logoutUser y updateUser." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="710" y="1490" width="620" height="90" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c7" value="&lt;b&gt;Rol&lt;/b&gt;&lt;br&gt;idRol (int), nombre: Administrador, Técnico, Docente, Estudiante&lt;br&gt;asignarPermisos()" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="1580" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c8" value="&lt;b&gt;UserRole&lt;/b&gt; (unión de literales)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="1580" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c9" value="La clase se vuelve una unión de 3 literales: Estudiante, Técnico_Laboratorio, Administrador_Laboratorio. No existen el rol Docente ni asignarPermisos(); las etiquetas están en ROLE_LABELS (shared/constants/roles.ts)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="710" y="1580" width="620" height="80" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c10" value="&lt;b&gt;Recurso&lt;/b&gt;&lt;br&gt;idRecurso (int), nombre, codigoInventario, tipo (String), estadoActual (String)&lt;br&gt;actualizarEstado(), darDeBaja()" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="1660" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c11" value="&lt;b&gt;Resource&lt;/b&gt;, ResourceType, ResourceStatus" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="1660" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c12" value="tipo y estadoActual pasan a uniones de literales. Los estados pasan de 6 (Disponible, Prestado, Reservado, Mantenimiento, Defectuoso, Baja) a 5 (Disponible, Reservado, En_Préstamo, En_Mantenimiento, Dado_de_Baja). Campos nuevos: descripcion, imagenUrl?, cantidadTotal, cantidadDisponible y fechaCreacion. Métodos: updateResourceStatus y retireResource." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="710" y="1660" width="620" height="80" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c13" value="&lt;b&gt;Prestamo&lt;/b&gt;&lt;br&gt;idPrestamo, fechaHoraReserva, fechaHoraEntrega, fechaHoraDevolucionReal, estadoPrestamo (Reservado, Activo, Devuelto, Retrasado)&lt;br&gt;calcularRetraso(), registrarEntrega(), registrarDevolucion()" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="1740" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c14" value="&lt;b&gt;Loan&lt;/b&gt;, LoanStatus, ResourceCondition" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="1740" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c15" value="Activo pasa a En_Préstamo y Retrasado deja de ser un estado: el retraso queda en retrasoHoras. LoanStatus añade Cancelado y Vencido, que ningún flujo asigna (Cancelado solo aparece en un préstamo de seed-data). Campos nuevos: idUsuario, idRecurso, fechaHoraInicioProgramada, fechaHoraFinProgramada, motivoPrestamo, condicionEntrega, condicionDevolucion, observacionesEntrega, observacionesDevolucion y retrasoHoras. Métodos: registerDelivery, registerReturn y calculateDelayHours." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="710" y="1740" width="620" height="110" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c16" value="&lt;b&gt;EstadoRecurso&lt;/b&gt; (historial)&lt;br&gt;idEstado (int), estado (String), fechaCambio" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="1850" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c17" value="&lt;b&gt;ResourceStatusHistory&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="1850" width="330" height="50" as="geometry"/></mxCell>
        <mxCell id="tabla-e1-c18" value="Añade idRecurso (la relación 1 a muchos con Recurso) y motivo?. Se escribe con appendStatusHistory en cada cambio de estado válido; ninguna pantalla lo muestra." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;strokeColor=#d79b00;fontColor=#1a1a1a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="710" y="1850" width="620" height="50" as="geometry"/></mxCell>
        <mxCell id="nota-diferencias" value="&lt;b&gt;Existe en el código y no en el Entregable 1&lt;/b&gt;&lt;br&gt;Session (sesión simulada con expiresAt), Sanction y SanctionStatus (Post-MVP), OperationResult&amp;lt;T&amp;gt;, los tipos de formulario (RegisterFormData, LoanFormData, CreateResourceData, DeliveryData, ReturnData, ResourceFilters), ToastType y las uniones ResourceType y ResourceCondition. Tampoco estaban la reserva programada (inicio y fin), la cantidad por recurso ni la condición de entrega y devolución.&lt;br&gt;&lt;br&gt;&lt;b&gt;Existe en el Entregable 1 y no en el código&lt;/b&gt;&lt;br&gt;La clase Rol y asignarPermisos(); el rol Docente; los estados Prestado, Defectuoso, Activo y Retrasado; RN-03 (máximo 3 préstamos activos) y RN-05 (horario operativo), que no están implementadas. Los métodos de las clases del E1 no existen como métodos: los tipos son datos y la lógica está en las funciones de services (página 4b)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1390" y="1420" width="790" height="170" as="geometry"/></mxCell>
        <mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt; (notación UML usada)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="1630" width="790" height="430" as="geometry"/></mxCell>
        <mxCell id="lg1-m" value="&lt;b&gt;Clase&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1410" y="1680" width="110" height="20" as="geometry"/></mxCell>
        <mxCell id="lg1-t" value="Clase o interface de TypeScript: nombre, campos (campo: tipo) y métodos" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1540" y="1680" width="620" height="20" as="geometry"/></mxCell>
