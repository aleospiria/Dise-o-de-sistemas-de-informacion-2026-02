<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Kiro" version="21.0.0" type="device">
  <diagram name="Actividad-HU-02" id="actividad-hu-02">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Diagrama de actividades HU-02 - Inicio de sesión" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="40" as="geometry"/></mxCell>
        <mxCell id="descripcion" value="Flujo implementado del inicio de sesión en /login. Cuando las credenciales fallan, el mensaje es siempre el mismo: no revela si el correo o la contraseña es incorrecto. La sesión dura 8 horas." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1020" height="50" as="geometry"/></mxCell>
        <mxCell id="carril-usuario" value="Visitante" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=center;fillColor=#eef4fb;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="320" height="1450" as="geometry"/></mxCell>
        <mxCell id="carril-sistema" value="Sistema" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=center;fillColor=#f7f7f7;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="640" height="1450" as="geometry"/></mxCell>
        <mxCell id="inicio" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="195" y="170" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="a1" value="Abrir la pantalla Iniciar sesión (/login); si viene del registro, el correo ya aparece escrito" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="a2" value="Escribir el correo y la contraseña" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="a3" value="Enviar el formulario con el botón Iniciar sesión" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="450" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="s1" value="Validar que el correo tenga formato válido y que la contraseña no esté vacía" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="440" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="d1" value="¿Los campos son válidos?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="560" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="b1" value="Mostrar el error bajo cada campo inválido y bloquear el botón hasta corregirlo" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="575" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="s2" value="Buscar el usuario por correo (sin distinguir mayúsculas) y verificar la contraseña contra su hash" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="720" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="d2" value="¿Las credenciales son correctas?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="850" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="b2" value="Mostrar el mensaje genérico «Correo o contraseña incorrectos.» sin indicar qué dato falló" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="865" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="s3" value="Crear la sesión (rol, nombre, correo, vence en 8 horas), guardarla en localStorage y activarla en la aplicación" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1010" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="d3" value="¿Se guardó la sesión?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="1150" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="b3" value="Mostrar la alerta «No se pudo guardar en el almacenamiento del navegador…»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="1165" width="220" height="80" as="geometry"/></mxCell>
