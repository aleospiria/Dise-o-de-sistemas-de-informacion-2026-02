        <mxCell id="s4" value="Mostrar el aviso «Hola, nombre.»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1310" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="s5" value="Redirigir a /dashboard" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1400" width="260" height="50" as="geometry"/></mxCell>
