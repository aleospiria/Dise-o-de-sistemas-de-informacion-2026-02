  <diagram name="Actividad-HU-03" id="actividad-hu-03">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Diagrama de actividades HU-03 - Consultar disponibilidad" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="descripcion" value="Flujo implementado de /availability para cualquier rol con sesión. Todos los filtros son opcionales: con fecha y hora válidas solo se listan los recursos reservables durante 1 hora desde ese momento. Solo el Estudiante ve el botón para solicitar préstamo." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1320" height="50" as="geometry"/></mxCell>
        <mxCell id="carril-usuario" value="Usuario autenticado (Estudiante, Técnico o Administrador)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=center;fillColor=#eef4fb;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="320" height="1680" as="geometry"/></mxCell>
        <mxCell id="carril-sistema" value="Sistema" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=center;fillColor=#f7f7f7;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="980" height="1680" as="geometry"/></mxCell>
        <mxCell id="inicio" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="195" y="170" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="a1" value="Abrir Disponibilidad (/availability) desde el menú" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="d0" value="¿Hay sesión activa?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="210" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="b0" value="Redirigir a /login" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1040" y="240" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="fin0" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1150" y="340" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="s0" value="Mostrar la página de disponibilidad con los filtros vacíos" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="375" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="a2" value="Indicar los filtros que desee (todos opcionales): nombre, tipo, fecha y hora" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="365" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="d1" value="¿Fecha y hora completas y futuras?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="480" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="s_vis" value="Tomar los recursos con estado Disponible, Reservado o En préstamo" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="650" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="s_win" value="Calcular la ventana de 1 hora desde la fecha y hora y tomar solo los recursos reservables en ese horario" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1040" y="650" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="d2" value="¿Fecha u hora incompleta o pasada?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="770" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="b1" value="Mostrar el aviso «Elige la fecha y la hora para filtrar por horario.» o «La fecha y la hora no pueden estar en el pasado.»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="770" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="s_fil" value="Filtrar por nombre (contiene el texto, sin distinguir mayúsculas; espera 300 ms) y por tipo, y ordenar por nombre" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="930" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="d3" value="¿Hay recursos en el resultado?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="1060" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="b3" value="Mostrar el mensaje «No hay recursos que coincidan con la búsqueda.»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;spacingLeft=6;spacingRight=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="1080" width="220" height="70" as="geometry"/></mxCell>
