        <mxCell id="d4" value="¿Reservable y usuario Estudiante?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="1360" width="240" height="110" as="geometry"/></mxCell>
