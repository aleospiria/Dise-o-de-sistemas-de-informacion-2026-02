        <mxCell id="l5-b" value="" style="ellipse;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="810" y="885" width="10" height="10" as="geometry"/></mxCell>
        <mxCell id="l5-e" value="verbo [tec.]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#999999;strokeWidth=1.5;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 8;" edge="1" parent="1" source="l5-a" target="l5-b"><mxGeometry relative="1" as="geometry"/></mxCell>
