<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Kiro" version="21.0.0" type="device">
  <diagram name="C4-1-Contexto" id="c4-1-contexto">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="&lt;b&gt;[Nivel 1] Contexto: Sistema de préstamo de recursos de laboratorio&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1220" height="40" as="geometry"/></mxCell>
        <mxCell id="descripcion" value="Muestra quién usa el sistema y con qué sistemas externos se relaciona. En el MVP no hay sistemas externos: todo corre en el navegador." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1220" height="50" as="geometry"/></mxCell>
        <mxCell id="p-est" value="&lt;b&gt;Estudiante&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Consulta la disponibilidad de recursos, solicita préstamos y revisa Mis préstamos. (E1: RU-01 a RU-04)" style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="340" height="190" as="geometry"/></mxCell>
        <mxCell id="p-tec" value="&lt;b&gt;Técnico de laboratorio&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Registra las entregas de las reservas y las devoluciones de los recursos (condición Bueno, Regular o Dañado) y consulta la disponibilidad. (E1: RU-02, RU-03, RU-06)" style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="140" width="340" height="190" as="geometry"/></mxCell>
        <mxCell id="p-adm" value="&lt;b&gt;Administrador de laboratorio&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Gestiona el inventario (alta, edición y baja de recursos); también registra entregas y devoluciones y consulta la disponibilidad. No solicita préstamos. (E1: RU-02, RU-03, RU-05, RU-06)" style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="340" height="190" as="geometry"/></mxCell>
        <mxCell id="sistema" value="&lt;b&gt;Sistema de préstamo de recursos de laboratorio&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;Aplicación web para registrarse e iniciar sesión, consultar la disponibilidad, reservar recursos, registrar entregas y devoluciones y gestionar el inventario. Los datos se guardan de forma simulada en el navegador (sin backend)." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="1180" height="130" as="geometry"/></mxCell>
        <mxCell id="e-p-est" value="Consulta disponibilidad, solicita préstamos&lt;br&gt;y ve Mis préstamos&lt;br&gt;[Navegador web]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.14407;entryY=0;" edge="1" parent="1" source="p-est" target="sistema"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-p-tec" value="Registra entregas y devoluciones&lt;br&gt;[Navegador web]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p-tec" target="sistema"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-p-adm" value="Gestiona el inventario y las operaciones&lt;br&gt;[Navegador web]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.85593;entryY=0;" edge="1" parent="1" source="p-adm" target="sistema"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="nota-externos" value="&lt;b&gt;Correo, ERP y backend/API&lt;/b&gt;&lt;br&gt;[Sistemas externos futuros, fuera del alcance del MVP]&lt;br&gt;No existen en el MVP: no se envían correos, no hay integración con ERP ni servidor; los datos viven solo en el navegador." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="560" height="120" as="geometry"/></mxCell>
        <mxCell id="e-futuro" value="FUTURO: no implementado en el MVP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#999999;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 8;exitX=0.23729;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sistema" target="nota-externos"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="720" width="560" height="200" as="geometry"/></mxCell>
        <mxCell id="l1-m" value="" style="rounded=1;arcSize=10;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="760" width="40" height="20" as="geometry"/></mxCell>
        <mxCell id="l1-t" value="Persona (usuario del sistema)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="840" y="760" width="380" height="20" as="geometry"/></mxCell>
