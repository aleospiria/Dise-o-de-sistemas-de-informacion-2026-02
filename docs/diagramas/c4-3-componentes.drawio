        <mxCell id="e-app-stor" value="inyecta localStorageRepository&lt;br&gt;[puerto StorageRepository]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.21429;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="stor"><mxGeometry x="0.8383" relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="440"/><mxPoint x="90" y="1410"/></Array></mxGeometry></mxCell>
