        <mxCell id="e-app-feat" value="registra las páginas de cada ruta&lt;br&gt;[React Router v7]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="feat"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
