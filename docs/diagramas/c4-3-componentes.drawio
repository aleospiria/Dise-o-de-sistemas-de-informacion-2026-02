<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Kiro" version="21.0.0" type="device">
  <diagram name="C4-3-Componentes" id="c4-3-componentes">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="&lt;b&gt;[Nivel 3] Componentes: Aplicación web SPA del sistema de préstamo de recursos de laboratorio&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1920" height="40" as="geometry"/></mxCell>
        <mxCell id="descripcion" value="Muestra los módulos de la SPA y los imports reales de producción entre ellos (las pruebas no se dibujan). En rojo punteado, las deudas conocidas: shared/components importa de contexts (6 archivos) y features/inventory y features/loans se importan mutuamente. Las features no importan de services: todo el acceso a datos pasa por contexts." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1920" height="50" as="geometry"/></mxCell>
        <mxCell id="p-est" value="&lt;b&gt;Estudiante&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Consulta disponibilidad, solicita préstamos y ve Mis préstamos." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="p-tec" value="&lt;b&gt;Técnico de laboratorio&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Registra entregas y devoluciones de recursos." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="p-adm" value="&lt;b&gt;Administrador de laboratorio&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;Gestiona el inventario y las operaciones." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="spa" value="&lt;b&gt;[Container: React 19 + TypeScript + Vite] Aplicación web SPA&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 8;verticalAlign=bottom;align=right;spacingRight=10;spacingBottom=6;fontColor=#444444;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1940" height="1210" as="geometry"/></mxCell>
        <mxCell id="app" value="&lt;b&gt;app (raíz de composición)&lt;/b&gt;&lt;br&gt;[Component: React 19 + React Router v7]&lt;br&gt;Compone los providers (Auth &amp;gt; AppData &amp;gt; UI) y define las rutas protegidas por rol. main.tsx monta App." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="520" y="410" width="600" height="140" as="geometry"/></mxCell>
        <mxCell id="feat" value="&lt;b&gt;features/*&lt;/b&gt; [Component group]: una carpeta por caso de uso (pages, components, hooks, validation)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;dashPattern=4 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="180" y="630" width="1280" height="320" as="geometry"/></mxCell>
        <mxCell id="f-auth" value="&lt;b&gt;features/auth&lt;/b&gt;&lt;br&gt;[Component: React + React Hook Form]&lt;br&gt;Inicio de sesión, registro y cuentas demo." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="200" y="680" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="f-inv" value="&lt;b&gt;features/inventory&lt;/b&gt;&lt;br&gt;[Component: React + React Hook Form]&lt;br&gt;Inventario: tabla, formulario de recurso y baja." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="460" y="680" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="f-loans" value="&lt;b&gt;features/loans&lt;/b&gt;&lt;br&gt;[Component: React + React Hook Form]&lt;br&gt;Disponibilidad, solicitud de préstamo y Mis préstamos." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="720" y="680" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="f-dash" value="&lt;b&gt;features/dashboard&lt;/b&gt;&lt;br&gt;[Component: React]&lt;br&gt;Panel de resumen según el rol." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="980" y="680" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="f-ops" value="&lt;b&gt;features/operations&lt;/b&gt;&lt;br&gt;[Component: React + React Hook Form]&lt;br&gt;Entregas y devoluciones de recursos." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1240" y="680" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="ctx" value="&lt;b&gt;contexts (estado global)&lt;/b&gt;&lt;br&gt;[Component: React Context + useReducer]&lt;br&gt;AuthProvider, AppDataProvider y UIProvider. Exponen el estado con los hooks useAuth, useLoans, useResources, useUsers y useToast, y lo sincronizan con el puerto de almacenamiento." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="360" y="1040" width="860" height="160" as="geometry"/></mxCell>
        <mxCell id="mock" value="&lt;b&gt;services/mockDb (servicios de dominio)&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;auth, loans, resources y users.service más seed-data. Aplican las reglas de negocio y devuelven OperationResult." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="860" y="1320" width="360" height="180" as="geometry"/></mxCell>
        <mxCell id="stor" value="&lt;b&gt;services/storage (puerto y adaptadores)&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;Puerto StorageRepository, adaptador LocalStorageRepository e InMemoryStorageRepository (solo en pruebas)." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="360" y="1320" width="360" height="180" as="geometry"/></mxCell>
        <mxCell id="shk" value="&lt;b&gt;shared: interfaz (components y pages)&lt;/b&gt;&lt;br&gt;[Component: React + CSS Modules]&lt;br&gt;ui (Button, Input, Modal, Toast, StatusBadge...), layout (AppShell, Sidebar, AuthLayout), guards (PrivateRoute, GuestRoute, RoleGuard) y NotFoundPage." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1620" y="630" width="280" height="320" as="geometry"/></mxCell>
        <mxCell id="shn" value="&lt;b&gt;shared: constants, utils, hooks y types&lt;/b&gt;&lt;br&gt;[Component: TypeScript]&lt;br&gt;constants (resourceStateMachine, lsKeys, roles, navigation), utils (validators, dateUtils, formResolver, resourceRules), hooks de apoyo y tipos del dominio." style="rounded=1;arcSize=6;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1620" y="1020" width="280" height="450" as="geometry"/></mxCell>
        <mxCell id="ls" value="&lt;b&gt;Almacenamiento local del navegador&lt;/b&gt;&lt;br&gt;[Container: localStorage, namespace sistema-prestamos-lab-]&lt;br&gt;Persistencia simulada de todos los datos del MVP." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;spacing=6;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="340" y="1680" width="400" height="170" as="geometry"/></mxCell>
        <mxCell id="e-est-app" value="Consulta, solicita y ve sus préstamos&lt;br&gt;[Navegador web, HTTP(S)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p-est" target="app"><mxGeometry x="-0.1579" relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="300"/><mxPoint x="640" y="300"/></Array></mxGeometry></mxCell>
