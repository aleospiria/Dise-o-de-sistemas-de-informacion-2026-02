<mxfile host="app.diagrams.net" agent="Kiro" version="21.0.0" type="device">
  <diagram name="Actividad-HU-06" id="actividad-hu-06">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="1950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Diagrama de actividades HU-06 - Registrar entrega y devolución" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1140" height="40" as="geometry"/></mxCell>
        <mxCell id="descripcion" value="Flujo implementado del técnico en /deliveries y /returns. La entrega pasa el préstamo de «Reservado» a «En_Préstamo». La devolución lo cierra como «Devuelto», calcula el retraso y fija el estado del recurso según la condición (RETURN_CONDITION_STRATEGY); un recurso que ya está en mantenimiento o dado de baja conserva su estado." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1140" height="50" as="geometry"/></mxCell>
        <mxCell id="banda-tecnico" value="Técnico de laboratorio" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#eef4fb;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1140" height="590" as="geometry"/></mxCell>
        <mxCell id="banda-sistema" value="Sistema" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#f7f7f7;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1140" height="1180" as="geometry"/></mxCell>
        <mxCell id="inicio" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="d0" value="¿Qué operación va a registrar?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="335" y="240" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="tE1" value="Abrir Entregas (/deliveries), elegir una reserva pendiente (su hora de inicio ya llegó) y pulsar «Registrar entrega»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="tR1" value="Abrir Devoluciones (/returns), elegir un préstamo en curso (se muestra el retraso acumulado) y pulsar «Registrar devolución»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="640" y="420" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="tE2" value="Indicar la condición del recurso y las observaciones, y confirmar la entrega" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="tR2" value="Indicar la condición del recurso y las observaciones, y confirmar la devolución" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="640" y="580" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="sD1" value="Validar el formulario: condición obligatoria; observaciones de hasta 500 caracteres y obligatorias si la condición es «Dañado»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="750" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="dD1" value="¿Los datos son válidos?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="920" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="bD1" value="Mostrar el error junto al campo" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="950" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="sD2" value="Registrar la entrega: el préstamo pasa a «En_Préstamo» con fecha, condición y observaciones" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="1090" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="dD2" value="¿Recurso agotado sin más reservas por entregar?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="60" y="1240" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="sD3" value="Cambiar el recurso de «Reservado» a «En_Préstamo» y anotarlo en el historial de estados" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="1430" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="sD4" value="Mostrar el aviso «Entrega registrada» y quitar la reserva de la lista de pendientes" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="1580" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="finD" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="1720" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="sR1" value="Validar el formulario: condición obligatoria y observaciones de hasta 500 caracteres" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="640" y="750" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="dR1" value="¿Los datos son válidos?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="640" y="900" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="bR1" value="Mostrar el error junto al campo" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="950" y="930" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="sR2" value="Registrar la devolución: retraso = máx(0, devolución real − fin programado) en horas; el préstamo pasa a «Devuelto»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="640" y="1070" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="sR3" value="Sumar una unidad a la cantidad disponible del recurso" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="640" y="1230" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="dR3" value="¿Qué condición se registró?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="640" y="1360" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="sR5" value="Pasar el recurso a «En_Mantenimiento» (estrategia por condición)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="950" y="1370" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="sR4" value="Pasar el recurso a «Disponible» (estrategia por condición)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="640" y="1530" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="sR6" value="Mostrar el resumen: retraso o «Devuelto a tiempo» y, si hubo daño, el aviso de mantenimiento" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="640" y="1660" width="230" height="100" as="geometry"/></mxCell>
