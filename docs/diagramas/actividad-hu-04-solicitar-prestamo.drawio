<mxfile host="app.diagrams.net" agent="Kiro" version="21.0.0" type="device">
  <diagram name="Actividad-HU-04" id="actividad-hu-04">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1130" pageHeight="2180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Diagrama de actividades HU-04 - Solicitar préstamo" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1050" height="40" as="geometry"/></mxCell>
        <mxCell id="descripcion" value="Flujo implementado de la solicitud en /loans/new/:resourceId (rol Estudiante). El formulario tiene una sola fecha, por eso el préstamo empieza y termina el mismo día. Al crear la reserva se resta una unidad disponible; el recurso solo pasa a «Reservado» cuando la cantidad disponible llega a 0." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1050" height="50" as="geometry"/></mxCell>
        <mxCell id="carril-usuario" value="Estudiante" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=center;fillColor=#eef4fb;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="320" height="2000" as="geometry"/></mxCell>
        <mxCell id="carril-sistema" value="Sistema" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=center;fillColor=#f7f7f7;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="690" height="2000" as="geometry"/></mxCell>
        <mxCell id="inicio" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="195" y="170" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="a1" value="Abrir Disponibilidad (/availability) y pulsar «Solicitar préstamo» en un recurso reservable" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="s0" value="Cargar el recurso indicado en la ruta /loans/new/:resourceId" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="260" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="d0" value="¿El recurso existe y se puede reservar?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="690" y="370" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="b0" value="Mostrar el aviso «No encontramos el recurso» o «no está disponible» con enlace para volver a disponibilidad" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="370" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="fin0" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="470" y="530" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="s1" value="Mostrar el resumen del recurso y el formulario (la fecha de hoy viene preseleccionada)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="580" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="a2" value="Completar la fecha, la hora de inicio, la hora de fin y el motivo del préstamo" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="580" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="a3" value="Pulsar «Confirmar reserva»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="720" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="Validar el formulario: campos obligatorios, motivo de 10 a 500 caracteres, inicio no pasado y duración de 1 a 24 horas" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="700" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="d1" value="¿Los datos son válidos?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="690" y="850" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="b1" value="Mostrar el error junto al campo inválido y bloquear el botón hasta corregirlo" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="870" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="s3" value="Revalidar en el servicio los tiempos y el motivo, y contar las reservas solapadas del recurso en el horario" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1020" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="d2" value="¿Hay unidades libres en el horario elegido?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="690" y="1170" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="b2" value="Mostrar la alerta «El recurso no está disponible en el horario seleccionado.»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="1180" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="s4" value="Crear el préstamo en estado «Reservado» con el motivo y la fecha de reserva, y guardarlo en localStorage" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1340" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="s5" value="Restar una unidad a la cantidad disponible del recurso" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1480" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="d3" value="¿La cantidad disponible llegó a 0?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="690" y="1590" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="s6" value="Cambiar el recurso a «Reservado» y anotar «Stock agotado por reservas» en el historial de estados" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1760" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="s7" value="Mostrar el aviso «Reserva creada. Quedó en estado Reservado.» y pasar a /loans/my" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="700" y="1910" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="a4" value="Ver la reserva en Mis préstamos con estado «Reservado»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="100" y="1910" width="220" height="80" as="geometry"/></mxCell>
