<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Kiro" version="21.0.0" type="device">
  <diagram name="Actividad-HU-05" id="actividad-hu-05">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Diagrama de actividades HU-05 - Gestión de inventario" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1580" height="40" as="geometry"/></mxCell>
        <mxCell id="descripcion" value="Flujo implementado del administrador en /inventory: registrar, editar y dar de baja un recurso. La baja se rechaza si el recurso tiene préstamos «Reservado» o «En_Préstamo». Un recurso dado de baja sigue en el listado del inventario, sin acciones, y deja de aparecer en la disponibilidad." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1580" height="50" as="geometry"/></mxCell>
        <mxCell id="banda-admin" value="Administrador" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#eef4fb;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1580" height="550" as="geometry"/></mxCell>
        <mxCell id="banda-sistema" value="Sistema" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#f7f7f7;strokeColor=#9aa9bb;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1580" height="1030" as="geometry"/></mxCell>
        <mxCell id="inicio" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="a0" value="Abrir Inventario (/inventory) y revisar el listado de recursos" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="d0" value="¿Qué operación realiza?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="555" y="360" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="aA" value="Pulsar «Nuevo recurso» (/inventory/new), completar el formulario y guardar" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="540" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="aE" value="Pulsar «Editar» en un recurso (/inventory/:id/edit), modificar los datos y guardar" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="580" y="540" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="aB" value="Pulsar «Dar de baja» en un recurso y confirmar en el diálogo" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1080" y="540" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="sA1" value="Validar el formulario: nombre (hasta 100 caracteres), código y tipo obligatorios, descripción de hasta 500 y cantidad entera mayor que 0" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="710" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="dA1" value="¿Los datos son válidos?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="880" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="bA1" value="Mostrar el error junto al campo" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="390" y="910" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="sA2" value="Crear el recurso en estado «Disponible» con todas sus unidades disponibles y guardarlo en localStorage" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="1050" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="sA3" value="Mostrar el aviso «Recurso creado» y volver al listado (/inventory)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="80" y="1190" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="finA" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="1310" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="sE1" value="Validar el formulario con las mismas reglas; la cantidad no puede ser menor que las unidades en uso (prestadas o reservadas)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="580" y="710" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="dE1" value="¿Los datos son válidos?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="580" y="880" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="bE1" value="Mostrar el error junto al campo" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="890" y="910" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="sE2" value="Guardar los datos nuevos: las unidades en uso se conservan y las libres siguen al nuevo total" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="580" y="1050" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="sE3" value="Alinear el estado con el stock: sin unidades libres pasa a «Reservado»; con unidades libres y en «Reservado» o «En_Préstamo» vuelve a «Disponible»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="580" y="1190" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="sE4" value="Mostrar el aviso «Recurso actualizado» y volver al listado (/inventory)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="580" y="1370" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="finE" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="675" y="1490" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="sB1" value="Buscar préstamos del recurso en estado «Reservado» o «En_Préstamo»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1080" y="710" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="dB1" value="¿Tiene préstamos activos?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1080" y="840" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="bB1" value="Rechazar la baja y avisar «No se puede dar de baja: el recurso tiene préstamos activos.»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1390" y="830" width="150" height="140" as="geometry"/></mxCell>
        <mxCell id="finB1" value="" style="ellipse;shape=endState;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1445" y="1010" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="sB2" value="Pedir el cambio de estado a «Dado_de_Baja», que valida la transición en la máquina de estados" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1080" y="1010" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="dB2" value="¿La transición de estado es válida?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1070" y="1160" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="bB2" value="Rechazar la baja y avisar «Transición de estado inválida»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1390" y="1180" width="150" height="100" as="geometry"/></mxCell>
