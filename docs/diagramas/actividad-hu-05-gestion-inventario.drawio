        <mxCell id="sB3" value="Cambiar el estado a «Dado_de_Baja» y anotarlo en el historial de estados" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1080" y="1350" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="sB4" value="Mostrar el aviso «fue dado de baja»; el recurso sigue en el listado sin acciones y sale de la disponibilidad" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1080" y="1470" width="230" height="100" as="geometry"/></mxCell>
